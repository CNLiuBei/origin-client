+    private var displayConstraints: [NSLayoutConstraint] = []
+
+    #if os(macOS)
+    private var pipObservers: [NSObjectProtocol] = []
+    private var pipSize: CGSize? {
+        didSet { applyPictureInPictureSize() }
+    }
+
+    /// macOS 的画中画窗口用 CALayerHost 按 1:1 像素镜像 displayLayer，不会做缩放，
+    /// 只能让 displayLayer 的尺寸跟随画中画窗口，否则画面只显示左下角一块且不随窗口缩放
+    public func followPictureInPictureWindow(_ follow: Bool) {
+        pipObservers.forEach(NotificationCenter.default.removeObserver)
+        pipObservers = []
+        guard follow else {
+            pipSize = nil
+            return
+        }
+        let center = NotificationCenter.default
+        for name in [NSWindow.didResizeNotification, NSWindow.didUpdateNotification, NSWindow.didChangeScreenNotification] {
+            pipObservers.append(center.addObserver(forName: name, object: nil, queue: .main) { [weak self] note in
+                guard let window = note.object as? NSWindow else { return }
+                MainActor.assumeIsolated { self?.syncPictureInPicture(window: window) }
+            })
+        }
+        NSApp.windows.forEach(syncPictureInPicture)
+    }
+
+    private func syncPictureInPicture(window: NSWindow) {
+        guard window !== self.window, String(describing: type(of: window)).contains("PIP"), window.isVisible else { return }
+        let size = window.contentLayoutRect.size
+        guard size.width > 1, size.height > 1 else { return }
+        let sourceScale = self.window?.backingScaleFactor ?? 1
+        let scale = window.backingScaleFactor / sourceScale
+        let target = CGSize(width: (size.width * scale).rounded(), height: (size.height * scale).rounded())
+        if target != pipSize { pipSize = target }
+    }
+
+    private func applyPictureInPictureSize() {
+        if let pipSize {
+            NSLayoutConstraint.deactivate(displayConstraints)
+            displayView.translatesAutoresizingMaskIntoConstraints = true
+            displayView.frame = CGRect(origin: .zero, size: pipSize)
+        } else if !displayConstraints.isEmpty, displayView.translatesAutoresizingMaskIntoConstraints {
+            displayView.translatesAutoresizingMaskIntoConstraints = false
+            NSLayoutConstraint.activate(displayConstraints)
+        }
+    }
+    #endif
